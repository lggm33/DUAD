set shell := ["bash", "-cu"]

PYTHON := "python3"
VENV_DIR := ".venv"
PORT := "8000"
ALEMBIC := "{{VENV_DIR}}/bin/alembic"

# Create a local virtual environment
venv:
	{{PYTHON}} -m venv {{VENV_DIR}}

# Install dependencies into the venv (pip)
install: venv
	{{VENV_DIR}}/bin/pip install --upgrade pip
	{{VENV_DIR}}/bin/pip install -r requirements.txt

# Run the app locally (development)
dev:
	APP_ENV=staging DEBUG=true PORT={{PORT}} {{VENV_DIR}}/bin/python main.py

# Run the app like production (gunicorn)
prod:
	APP_ENV=production PORT={{PORT}} {{VENV_DIR}}/bin/gunicorn --bind 0.0.0.0:${PORT} main:app

# Run tests
test:
	{{VENV_DIR}}/bin/python -m pytest -q

# Database migrations (Alembic)
# Note: DATABASE_URL is read from the environment (or .env via migrations/env.py).
db-revision message:
	APP_ENV=staging {{ALEMBIC}} revision --autogenerate -m "{{message}}"

db-up:
	APP_ENV=staging {{ALEMBIC}} upgrade head

db-down steps="1":
	APP_ENV=staging {{ALEMBIC}} downgrade -{{steps}}


