set shell := ["bash", "-cu"]

PYTHON := "python3"
VENV_DIR := ".venv"
PORT := "8000"
VENV_PYTHON := VENV_DIR + "/bin/python"
VENV_PIP := VENV_DIR + "/bin/pip"

# Create a local virtual environment
venv:
	{{PYTHON}} -m venv {{VENV_DIR}}

# Install dependencies into the venv (pip)
install: venv
	{{VENV_PIP}} install --upgrade pip
	{{VENV_PIP}} install -r requirements.txt

# Run the app locally (development)
dev:
	APP_ENV=staging DEBUG=true PORT={{PORT}} {{VENV_PYTHON}} main.py

# Run the app like production (gunicorn)
prod:
	APP_ENV=production PORT={{PORT}} {{VENV_DIR}}/bin/gunicorn --bind 0.0.0.0:${PORT} main:app

# Run tests
test:
	{{VENV_PYTHON}} -m pytest -q

# Database migrations (Alembic)
# Note: DATABASE_URL is read from the environment (or .env via migrations/env.py).
db-revision message: install
	APP_ENV=staging {{VENV_PYTHON}} -m alembic revision --autogenerate -m "{{message}}"

db-up: install
	APP_ENV=staging {{VENV_PYTHON}} -m alembic upgrade head

db-down steps="1": install
	APP_ENV=staging {{VENV_PYTHON}} -m alembic downgrade -{{steps}}


