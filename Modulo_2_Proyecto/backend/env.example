APP_ENV=staging
DEBUG=true
SQLALCHEMY_ECHO=false

# Railway (staging) connection strings.
# Copy from Railway variables for your staging environment.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
REDIS_URL=redis://:PASSWORD@HOST:PORT/0

# Flask secret key used for sessions/signing.
SECRET_KEY=replace-me

# JWT Configuration
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES=3600  # 1 hour in seconds

# Destructive DDL and Unsafe Query Configuration
ALLOW_DESTRUCTIVE_DDL=false
ALLOW_UNSAFE_QUERY=false
