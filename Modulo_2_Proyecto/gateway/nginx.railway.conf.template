server {
  listen ${PORT};
  server_name _;

  # Hide version details in responses
  server_tokens off;

  # Re-resolve Railway internal DNS as services redeploy and their backing IPs change.
  # The resolver is injected at container start from /etc/resolv.conf.
  resolver ${RESOLVER} valid=10s ipv6=on;
  resolver_timeout 5s;

  # Basic request limits (defense in depth)
  client_max_body_size 2m;
  client_body_timeout 15s;
  send_timeout 30s;

  # Minimal security headers (defense in depth)
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

  # Standard proxy headers
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $host;

  # Backend routes
  location ^~ /api/ {
    # Only allow common API methods
    if ($request_method !~ ^(GET|POST|PUT|PATCH|DELETE|OPTIONS)$) {
      return 405;
    }

    set $backend_upstream "${BACKEND_UPSTREAM}";

    # Avoid forwarding untrusted client Host header to the backend.
    # Extract upstream hostname from BACKEND_UPSTREAM (http[s]://host[:port]).
    set $backend_host "";
    if ($backend_upstream ~* ^https?://([^/:]+)) {
      set $backend_host $1;
    }
    proxy_set_header Host $backend_host;

    proxy_pass $backend_upstream;
  }

  # Socket.IO endpoint for real-time chat
  location /socket.io/ {
    set $backend_upstream "${BACKEND_UPSTREAM}";

    # Extract upstream hostname
    set $backend_host "";
    if ($backend_upstream ~* ^https?://([^/:]+)) {
      set $backend_host $1;
    }

    # WebSocket upgrade headers
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $backend_host;

    # Disable buffering for WebSocket
    proxy_buffering off;

    # Long timeouts for persistent connections (24 hours)
    proxy_read_timeout 86400s;
    proxy_send_timeout 86400s;

    proxy_pass $backend_upstream;
  }

  # Frontend routes
  location / {
    # Only allow safe methods for static content
    if ($request_method !~ ^(GET|HEAD|OPTIONS)$) {
      return 405;
    }

    set $frontend_upstream "${FRONTEND_UPSTREAM}";

    # Avoid forwarding untrusted client Host header to the frontend upstream.
    set $frontend_host "";
    if ($frontend_upstream ~* ^https?://([^/:]+)) {
      set $frontend_host $1;
    }
    proxy_set_header Host $frontend_host;

    proxy_pass $frontend_upstream;
  }
}


